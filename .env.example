# MoneyFlow environment configuration (placeholders only).
#
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# See docs/runbooks/local-development.md for how these are used.

# ── API (apps/api, NestJS) ─────────────────────────────────────────────
# Port the API listens on (default: 4000).
PORT=4000

# Comma-separated browser origins allowed to call the API.
# Leave empty to disable CORS. Add the exact port Next.js uses; 3001 is the
# common fallback when 3000 is already occupied.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Authentication (apps/api, Better Auth — ADR-0006) ──────────────────
# Secret used to sign session cookies and tokens (≥ 32 characters).
# Generate one: openssl rand -base64 32
# Required in production; a blank value means "unset" locally (the library
# falls back to its development default — never use that in production).
BETTER_AUTH_SECRET=

# Public base URL of the API as browsers reach it. Used for auth callbacks,
# CSRF origin checks, and cookie security (must be https in production).
# Locally, defaults to http://localhost:$PORT when unset.
BETTER_AUTH_URL=http://localhost:4000

# Google Sign-In (optional). Set BOTH values together or neither; startup
# validation rejects a half-configured pair. Requires registered redirect
# URIs in the Google console. Left commented until real credentials exist.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# PostgreSQL connection string used by Prisma at runtime (the pooled
# endpoint on Neon in deployed environments). Required in production;
# required for all database commands. Keep the user/password in sync with
# POSTGRES_* below for local setup.
DATABASE_URL=postgresql://local_dev_user:CHANGE_ME@localhost:5432/moneyflow_dev?schema=public

# Direct (non-pooled) connection used by the Prisma CLI for migrations and
# schema tooling. Optional locally (falls back to DATABASE_URL); on Neon it
# is the unpooled endpoint (ADR-0007).
DIRECT_URL=postgresql://local_dev_user:CHANGE_ME@localhost:5432/moneyflow_dev?schema=public

# Throwaway database for integration tests (moneyflow_test in the local
# Docker instance / CI service container). The test harness refuses any
# host that is not localhost — never point this at shared data.
TEST_DATABASE_URL=postgresql://local_dev_user:CHANGE_ME@localhost:5432/moneyflow_test?schema=public

# ── Web (apps/web, Next.js) ────────────────────────────────────────────
# Base URL for server-side API calls (server components, route handlers).
API_URL=http://localhost:4000

# Browser-visible API base URL. Only variables prefixed with NEXT_PUBLIC_
# are exposed to client-side code. Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Local PostgreSQL (infrastructure/docker/docker-compose.yml) ────────
# Consumed via: docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d
# Local-development placeholders only — replace for any shared environment.
POSTGRES_USER=local_dev_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=moneyflow_dev
POSTGRES_PORT=5432
