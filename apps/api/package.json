{
  "name": "@moneyflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "auth:generate": "auth generate --config src/auth.ts --adapter prisma --dialect postgresql -y",
    "auth:check": "auth check schema --config src/auth.ts",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "pretest:integration": "prisma generate"
  },
  "dependencies": {
    "@moneyflow/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@moneyflow/config": "workspace:*",
    "@moneyflow/test-utils": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "auth": "^1.7.10",
    "eslint": "^10.12.0",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
